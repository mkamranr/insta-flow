# ---------------------------------------------------------------------------
# Social Flow configuration. Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------

APP_ENV=development
LOG_LEVEL=INFO

# Public HTTPS base URL. With Tailscale Funnel this is your MagicDNS name.
# Must match the OAuth redirect URI and webhook URL registered in the Meta app.
# Host port Caddy is published on (loopback only). Must not collide with
# another local service, or Tailscale Funnel may expose the wrong one.
HOST_PORT=8090

# The public origin every URL is derived from. An operator can override this
# from Settings > Public address without touching .env; this is the fallback.
PUBLIC_BASE_URL=https://your-machine.your-tailnet.ts.net

# --- Datastores -------------------------------------------------------------
MONGO_URL=mongodb://mongodb:27017
MONGO_DATABASE=instaflow
REDIS_URL=redis://redis:6379/0

# --- Meta / Instagram -------------------------------------------------------
# From App Dashboard > Instagram > API setup with Instagram login.
# These are the INSTAGRAM App ID/Secret, not the Facebook ones. See docs/meta-api.md.
#
# The instance-wide DEFAULT, not a requirement. Each user can configure their own
# Meta app from Settings, which is what lets a second person connect their own
# Instagram account without App Review (docs/meta-api.md 7b). A workspace using
# these values keeps the unprefixed /webhooks/instagram and callback URLs.
# Leave them blank if every user brings their own app.
META_APP_ID=
META_APP_SECRET=
# Any random string you choose; must match the Verify token in the Meta dashboard.
# Generate: openssl rand -hex 32
META_WEBHOOK_VERIFY_TOKEN=
META_API_VERSION=v25.0

# --- Secrets ----------------------------------------------------------------
# Generate both: openssl rand -hex 32
ENCRYPTION_KEY=
SESSION_SECRET=

# Lets the FIRST admin account be created from the login page, for a deployment
# with no shell to run `make bootstrap-admin`. Leave empty to disable that route
# entirely -- an unset value never means "no code required".
#
# At least 16 characters, and it stops working the moment any user exists, so
# there is no need to remove it afterwards. Generate one with:
#   openssl rand -hex 32
ADMIN_SETUP_SECRET=

# --- Safety -----------------------------------------------------------------
# true = full pipeline runs but NO Meta mutation is ever sent. Keep true until tested.
DRY_RUN=true

# --- Optional AI (off by default) -------------------------------------------
# OpenAI-compatible endpoint: Ollama locally, or vLLM on a GPU host.
AI_ENABLED=false
AI_BASE_URL=http://host.docker.internal:11434/v1
AI_MODEL=qwen3:8b
AI_TIMEOUT_SECONDS=10
AI_MIN_CONFIDENCE=0.7

# --- Optional email (off by default) ----------------------------------------
# The SMTP host, port, username, password and sender do NOT live here: they are
# stored in the database and edited on the Settings page, because that is where
# an operator without shell access needs them. There is deliberately no
# EMAIL_ENABLED either -- "is mail set up" is a question about that stored
# document, and a second answer here would be two sources of truth for one fact.
#
# auto = real SMTP once those settings are filled in, mock otherwise.
# Note DRY_RUN does NOT suppress email: it means "no Meta mutation", and an
# invitation is not one. Use EMAIL_CLIENT=mock to stop mail leaving the server.
EMAIL_CLIENT=auto
