# ---------------------------------------------------------------------------
# Social Flow configuration. Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------

APP_ENV=development
LOG_LEVEL=INFO

# Public HTTPS base URL. With Tailscale Funnel this is your MagicDNS name.
# Must match the OAuth redirect URI and webhook URL registered in the Meta app.
# Host port Caddy is published on (loopback only). Must not collide with
# another local service, or Tailscale Funnel may expose the wrong one.
HOST_PORT=8090

PUBLIC_BASE_URL=https://your-machine.your-tailnet.ts.net

# --- Datastores -------------------------------------------------------------
MONGO_URL=mongodb://mongodb:27017
MONGO_DATABASE=instaflow
REDIS_URL=redis://redis:6379/0

# --- Meta / Instagram -------------------------------------------------------
# From App Dashboard > Instagram > API setup with Instagram login.
# These are the INSTAGRAM App ID/Secret, not the Facebook ones. See docs/meta-api.md.
META_APP_ID=
META_APP_SECRET=
# Any random string you choose; must match the Verify token in the Meta dashboard.
# Generate: openssl rand -hex 32
META_WEBHOOK_VERIFY_TOKEN=
META_API_VERSION=v25.0

# --- Secrets ----------------------------------------------------------------
# Generate both: openssl rand -hex 32
ENCRYPTION_KEY=
SESSION_SECRET=

# Lets the FIRST admin account be created from the login page, for a deployment
# with no shell to run `make bootstrap-admin`. Leave empty to disable that route
# entirely -- an unset value never means "no code required".
#
# At least 16 characters, and it stops working the moment any user exists, so
# there is no need to remove it afterwards. Generate one with:
#   openssl rand -hex 32
ADMIN_SETUP_SECRET=

# --- Safety -----------------------------------------------------------------
# true = full pipeline runs but NO Meta mutation is ever sent. Keep true until tested.
DRY_RUN=true

# --- Optional AI (off by default) -------------------------------------------
# OpenAI-compatible endpoint: Ollama locally, or vLLM on a GPU host.
AI_ENABLED=false
AI_BASE_URL=http://host.docker.internal:11434/v1
AI_MODEL=qwen3:8b
AI_TIMEOUT_SECONDS=10
AI_MIN_CONFIDENCE=0.7


# --- AWS / production only ---------------------------------------------------
# Ignored by docker-compose.yml; read by docker-compose.prod.yml.

# Where `make push` sends images. The registry host embeds your AWS account ID,
# which is why it lives here rather than in the repo.
#   ECR_REGISTRY=<account-id>.dkr.ecr.<region>.amazonaws.com
ECR_REGISTRY=
ECR_REPO=
AWS_REGION=

# The domain pointed at the instance's Elastic IP. Caddy obtains a Let's Encrypt
# certificate for it automatically, so ports 80 AND 443 must be open. Meta will
# not accept a bare IP or a self-signed certificate for a webhook callback.
SITE_DOMAIN=

# MongoDB runs with no authentication locally. On a public host it must not.
# These apply ONLY to a fresh data volume -- setting them after the first `up`
# silently does nothing, so set them before the first boot.
MONGO_USER=
MONGO_PASSWORD=

# With auth on, MONGO_URL must carry the credentials and the auth database:
#   MONGO_URL=mongodb://USER:PASSWORD@mongodb:27017/?authSource=admin

# Which image tags to run. Defaults to the moving `api` / `web` tags; pin to a
# specific `api-<sha>` to roll back.
# API_TAG=api
# WEB_TAG=web

# Values that DIFFER from the defaults above in production:
#   PUBLIC_BASE_URL=https://your.domain   drives the OAuth redirect, the webhook
#                                         URL, and every attachment URL Meta fetches
#   SESSION_COOKIE_SECURE=true            or the session cookie crosses plain HTTP
#   DRY_RUN=false                         when you are ready to send for real
#   ADMIN_SETUP_SECRET=<32 bytes>         set BEFORE first boot, so the login page
#                                         can create the first admin
#
# ENCRYPTION_KEY and SESSION_SECRET must be carried over UNCHANGED from any
# existing deployment: a new ENCRYPTION_KEY makes every stored Instagram token
# unreadable, and a new SESSION_SECRET logs everyone out.
