# Tailscale Funnel terminates TLS at the tailnet edge and forwards plain HTTP
# here, so this file must NOT contain TLS directives or a public hostname.
# For a domain-based deployment with Caddy-managed certs, see docs/deployment.md.

{
	servers {
		# Caddy v2 does NOT trust an inbound X-Forwarded-For unless the sender
		# is declared trusted -- it replaces it with the immediate peer. Behind
		# Tailscale Funnel that peer is the Docker gateway, so the visitor's
		# real address was being discarded and every click recorded as
		# unlocatable. Verified live: Caddy received 94.59.71.70 and the app
		# saw a private chain.
		#
		# Safe here because Caddy binds 127.0.0.1 only (see docker-compose.yml),
		# so nothing but the funnel and localhost can reach it to spoof a header.
		trusted_proxies static private_ranges
	}
}

:8080 {
	encode gzip

	# Access logging, on deliberately. Without it a silent webhook is
	# undiagnosable: "Meta never sent it" and "we dropped it at the edge" look
	# identical, and only this log separates them. Diagnosing a missing story
	# reply once cost an hour for exactly that reason.
	log {
		output stdout
		# The webhook verification handshake carries the verify token in the
		# QUERY STRING, so logging raw URIs writes a secret to the container
		# log. Redacted here rather than by turning logging off, because
		# without it "Meta never sent the request" and "we dropped it" are
		# indistinguishable.
		format filter {
			wrap json
			fields {
				request>uri query {
					replace hub.verify_token REDACTED
					replace hub_verify_token REDACTED
					# The invitation activation link. The SPA page is
					# /invite?token=..., so the token reaches this log the
					# same way the verify token once did -- and the whole
					# point of storing only its SHA-256 is that the raw
					# token exists nowhere at rest.
					replace token REDACTED
				}
			}
		}
	}

	# Per-workspace routes: /u/<slug>/api/..., /u/<slug>/webhooks/instagram, and
	# the two legal pages each Meta app needs its own URL for.
	#
	# path_regexp, not a `/u/*/api/*` glob: Caddy's path wildcards do not treat
	# `/` specially, so a glob would also swallow deeper paths and hand the API
	# requests meant for the SPA. Anything else under /u/<slug>/ falls through to
	# the catch-all below and is served by the SPA, which is what makes
	# /u/<slug>/posts a page rather than a 404.
	@workspace path_regexp ^/u/[^/]+/(api|webhooks|privacy|data-deletion)(/.*)?$
	handle @workspace {
		reverse_proxy api:8000
	}

	handle /api/* {
		reverse_proxy api:8000
	}

	handle /webhooks/* {
		reverse_proxy api:8000
	}

	handle /health {
		reverse_proxy api:8000
	}

	# Public pages Meta requires to publish the app.
	handle /privacy {
		reverse_proxy api:8000
	}

	handle /data-deletion {
		reverse_proxy api:8000
	}

	# Trackable link redirects.
	handle /r/* {
		reverse_proxy api:8000
	}

	# Uploaded attachments. Public and unauthenticated by necessity: Meta
	# fetches these itself when sending a DM and carries none of our
	# credentials (docs/meta-api.md §4c). Without this route they fall through
	# to the SPA, and Meta silently receives an HTML page instead of the file.
	#
	# Global, not per-workspace, like /r/ above: a storage key and a click token
	# are already unique across the instance, and Meta fetches an attachment with
	# no session and no workspace context at all.
	handle /files/* {
		reverse_proxy api:8000
	}

	handle /ready {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy frontend:3000
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		# The dashboard loads no third-party code. Post and story thumbnails are
		# cached and served from 'self' (their CDN URLs expire -- docs/meta-api.md
		# §2d), so https: remains only for the account's profile picture, which is
		# still a raw Meta CDN link.
		Content-Security-Policy "default-src 'self'; img-src 'self' https: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		# Tailscale terminates TLS, so HSTS is set here rather than by Caddy's
		# own TLS handling.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
}
